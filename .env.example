# ==============================================================================
# AI BUYER AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# LLM Providers Configuration
# The system can run using live APIs or with the built-in Intelligent Fallback / Simulation mode
# If keys are left blank or invalid, the system automatically falls back to deterministic multi-agent simulation.

# Anthropic Claude (Primary for Agent 2: Sourcing & Agent 4: Chief Buyer Orchestrator)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini (Primary for Agent 1: Inventory & Demand Intelligence)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
